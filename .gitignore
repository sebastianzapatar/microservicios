# ─── Terraform ───────────────────────────────────────────────────────────────
# IMPORTANT: Never commit these files!

# Local .terraform directory (dependencies)
**/.terraform/*

# Terraform state files (VERY SENSITIVE - contains passwords, keys, etc.)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Variables files (contain secrets)
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan files
*.tfplan
tfplan

# Terraform lock file (optional: you may want to commit .terraform.lock.hcl)
# .terraform.lock.hcl

# ─── GitHub Actions / AWS ─────────────────────────────────────────────────────
# AWS credentials (never commit!)
.aws/

# ─── Java / Spring Boot ───────────────────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear

# Eclipse
.classpath
.project
.settings/

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code
.vscode/

# Maven
.mvn/wrapper/maven-wrapper.jar

# ─── OS Files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Docker ───────────────────────────────────────────────────────────────────
# Ignore local docker volumes
postgres_data/

# ─── Environment files ────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
application-local.yml
application-secret.yml
